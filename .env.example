APP_NAME="FBR Digital Invoicing System"
APP_URL=http://localhost:8000
WEB_APP_URL=http://localhost:3000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pral
DB_USERNAME=pral
DB_PASSWORD=pral

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Transactional email (account verification + password reset) is sent via Resend.
# For local dev MAIL_MAILER=log writes mail to the Laravel log instead.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025

# Optional "Sign in with Google". See the README for the Google Cloud setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ENABLED=false

PRAL_USE_SANDBOX=true
PRAL_PRODUCTION_TOKEN=
PRAL_SANDBOX_TOKEN=
PRAL_PRODUCTION_BASE_URL=https://gw.fbr.gov.pk
PRAL_SANDBOX_BASE_URL=https://gw.fbr.gov.pk
