APP_NAME="FBR Digital Invoicing System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
APP_URL=http://localhost:8000
# Public origin of the payer-facing Next.js app. Raast/1LINK return and webhook
# URLs are built from this value. Set it to your deployed/public host.
WEB_APP_URL=http://localhost:3000
SAAS_REQUIRE_EMAIL_VERIFICATION=true
SAAS_EMAIL_VERIFICATION_EXPIRE=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pral
DB_USERNAME=pral
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=pral

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Transactional email (account verification + password reset) is sent via Resend.
# Set MAIL_MAILER=resend and provide RESEND_KEY, then make MAIL_FROM_ADDRESS a
# sender/domain that is verified in the Resend dashboard (see https://resend.com).
MAIL_MAILER=log
RESEND_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="invoices@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8081

# Optional "Sign in with Google" (laravel/socialite). Create an OAuth Web client
# in Google Cloud Console and register exactly one redirect URI:
#   <APP_URL>/api/auth/google/callback
# The Google button stays hidden on /login and /register until GOOGLE_ENABLED=true.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_ENABLED=false

PRAL_USE_SANDBOX=true
PRAL_PRODUCTION_TOKEN=
PRAL_SANDBOX_TOKEN=
PRAL_PRODUCTION_BASE_URL=https://gw.fbr.gov.pk
PRAL_SANDBOX_BASE_URL=https://gw.fbr.gov.pk
PRAL_TIMEOUT=30
PRAL_CACHE_TTL=86400

# Raast / 1LINK P2M merchant credentials (never commit real values). Read by
# the Raast gateway adapter at runtime. Required only for live initiation and
# webhook verification; sandbox checkouts ignore them.
RAST_API_KEY=
RAST_APP_SECRET=
