{
  "expo": {
    "name": "FBR Digital Invoicing System",
    "slug": "pral-invoicing",
    "scheme": "pral",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maktech.pral"
    },
    "android": {
      "package": "com.maktech.pral",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
